{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/admin(.*)", "destination": "/admin.html" },
    { "source": "/partner(.*)", "destination": "/partner.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
